# Обязательные (на Amvera задаются в разделе «Переменные» / «Секреты»)
BOT_TOKEN=123456789:AA...
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
CHANNEL_USERNAME=@your_music_channel
ADMIN_IDS=111111111,222222222
WEBAPP_URL=https://your-app-name.amvera.io

# Необязательные
# SECRET_KEY=длинная_случайная_строка   # ключ подписи сессий (по умолчанию выводится из BOT_TOKEN)
# WEBAPP_SHORT_NAME=app                  # короткое имя Mini App из /newapp (для прямых ссылок)
# YTDLP_PROXY=socks5://user:pass@host:1080   # прокси для YouTube (раздел «Контент»)
# YTDLP_COOKIES=/data/cookies.txt             # cookies.txt YouTube, если требуется проверка
# LOG_LEVEL=INFO
# DATA_DIR=/data
